# Public HTTPS base URL you will paste into the grader (trailing slash).
# Example: https://your-service.onrender.com/a2a/
PUBLIC_BASE_URL=http://localhost:8080/a2a/

# Optional: any OpenAI-compatible chat API. The provider is not graded.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant

# Alternative helpers (first non-empty key wins):
# GROQ_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

PORT=8080
DATA_DIR=./data
